<%@ Page Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="GioiThieu.aspx.cs" Inherits="baiTapLonBanh.GioiThieu" %>

<asp:Content ID="Content1"
    ContentPlaceHolderID="ContentPlaceHolder1"
    runat="server">
<link href="CSS/GioiThieu.css" rel="stylesheet" type="text/css" />
    <div class="gioi-thieu">
        <div class="tieu-de">
            VỀ SWEETCAKE
        </div>
        <div class="mo-dau">
            <p class="doan-dam">
                <span>SweetCake</span> là thương hiệu bánh ngọt mang đến
                những sản phẩm thơm ngon, đẹp mắt và phù hợp với nhiều
                dịp đặc biệt trong cuộc sống.
            </p>
            <p>
                Với mong muốn mang đến những chiếc bánh chất lượng cao,
                SweetCake luôn chú trọng từ khâu lựa chọn nguyên liệu,
                chế biến đến trang trí sản phẩm.
            </p>
            <p>
                Mỗi chiếc bánh được tạo nên bằng sự tỉ mỉ và tâm huyết,
                giúp khách hàng có những trải nghiệm ngọt ngào và đáng nhớ
                trong những dịp đặc biệt.
            </p>
        </div>

        <div class="banner-gioi-thieu">
            <img src="images/banner-gioithieu.jpg"
                 alt="SweetCake" />
        </div>

        <section class="noi-dung">

            <h2>THÀNH LẬP</h2>

            <p>
                SweetCake được xây dựng với mong muốn trở thành một địa chỉ
                tin cậy dành cho những người yêu thích bánh ngọt. Từ những
                sản phẩm đầu tiên, SweetCake luôn chú trọng đến chất lượng
                và hình thức của từng chiếc bánh.
            </p>

            <p>
                Với sự phát triển không ngừng, SweetCake hướng tới việc
                mang đến cho khách hàng những sản phẩm bánh đa dạng,
                thơm ngon và phù hợp với nhiều nhu cầu khác nhau.
            </p>

        </section>

        <section class="noi-dung">

            <h2>NHIỆM VỤ</h2>

            <p>
                Nhiệm vụ của SweetCake là mang đến những sản phẩm bánh
                chất lượng, được làm từ những nguyên liệu đảm bảo,
                kết hợp giữa hương vị thơm ngon và cách trang trí đẹp mắt.
            </p>

        </section>

        <section class="noi-dung">

            <h2>CAM KẾT KINH DOANH</h2>

            <p>
                SweetCake luôn đặt chất lượng sản phẩm và sự hài lòng
                của khách hàng lên hàng đầu. Chúng tôi cam kết mang đến
                những sản phẩm bánh tươi ngon, an toàn và phù hợp với
                nhu cầu của khách hàng.
            </p>

        </section>

    </div>

</asp:Content>
