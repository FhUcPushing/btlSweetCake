<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="baiTapLonBanh.Site" %>
<!DOCTYPE html>

<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>SweetCake</title>

    <link href="<%= ResolveUrl("~/CSS/Site.css") %>"
      rel="stylesheet" type="text/css" />

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<asp:ContentPlaceHolder ID="head" runat="server">
</asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server" enctype="multipart/form-data">
        <%
    
    string tenNguoiDung = Session["TenHienThi"] as string;
    bool daDangNhap = !string.IsNullOrEmpty(tenNguoiDung);
    string tenAnToan = daDangNhap ? Server.HtmlEncode(tenNguoiDung) : "";
%>

       
        <header class="site-header">
            <div class="nav-container">
               
                <div class="mobile-left-controls">
    <button type="button"
            class="menu-toggle"
            aria-label="Mở menu"
            aria-expanded="false"
            onclick="toggleMobileMenu()">
        <i class="fa-solid fa-bars"></i>
    </button>
</div>

                
                <a href="<%= ResolveUrl("~/TrangChu.aspx") %>"
                   class="brand"
                   aria-label="SweetCake - Trang chủ">
                    <span class="brand-icon">
                        <i class="fa-solid fa-cake-candles"></i>
                    </span>
                    <span class="brand-name">SweetCake</span>
                </a>

              
                <nav class="main-nav" id="mainNav">
                   
                    <% if (daDangNhap) { %>
                        <div class="nav-account">
                            <a href="<%= ResolveUrl("~/TaiKhoan.aspx") %>" class="nav-greeting">
    <i class="fa-solid fa-circle-user"></i>
    <span class="ten">Xin chào, <%= tenAnToan %></span>
</a>
                            <a href="<%= ResolveUrl("~/DangNhap.aspx?dangxuat=1") %>"
                               class="nav-logout"
                               title="Đăng xuất"
                               aria-label="Đăng xuất">
                                <i class="fa-solid fa-right-from-bracket"></i>
                            </a>
                        </div>
                    <% } else { %>
                        <div class="nav-account">
                            <a href="<%= ResolveUrl("~/DangNhap.aspx") %>">
                                <i class="fa-solid fa-user"></i>
                                Đăng nhập
                            </a>
                            <span>/</span>
                            <a href="<%= ResolveUrl("~/DangKy.aspx") %>">
                                <i class="fa-solid fa-user-plus"></i>
                                Đăng ký
                            </a>
                        </div>
                    <% } %>

                    <a href="<%= ResolveUrl("~/TrangChu.aspx") %>">
                        <i class="fa-solid fa-house"></i>
                        <span>Trang chủ</span>
                    </a>
                    <a href="<%= ResolveUrl("~/SanPham.aspx") %>">
                        <i class="fa-solid fa-cake-candles"></i>
                        <span>Sản phẩm</span>
                    </a>
                    <a href="<%= ResolveUrl("~/GioiThieu.aspx") %>">
                        <i class="fa-solid fa-store"></i>
                        <span>Giới thiệu</span>
                    </a>
                    <a href="<%= ResolveUrl("~/TinTuc.aspx") %>">
                        <i class="fa-regular fa-newspaper"></i>
                        <span>Tin tức</span>
                    </a>
                    <a href="<%= ResolveUrl("~/TuVan.aspx") %>">
                        <i class="fa-solid fa-headset"></i>
                        <span>Tư vấn</span>
                    </a>
                   
                </nav>

             
                <div class="header-right">
                    <div class="header-search" id="headerSearch">
    <input type="search"
           id="txtTimKiem"
           placeholder="Tìm bánh..."
           autocomplete="off"
           enterkeyhint="search"
           aria-label="Tìm kiếm bánh" />

    <button type="button"
            onclick="xuLyTimKiem()"
            aria-label="Tìm kiếm">
        <i class="fa-solid fa-magnifying-glass"></i>
    </button>
</div>
                    <div class="header-account">
                        <a href="<%= ResolveUrl("~/GioHang.aspx") %>"
                           class="cart-link"
                           aria-label="Giỏ hàng"
                           title="Giỏ hàng">
                            <i class="fa-solid fa-bag-shopping"></i>
                        </a>

                        <% if (daDangNhap) { %>
                            <a href="<%= ResolveUrl("~/TaiKhoan.aspx") %>" class="user-greeting" title="Tài khoản của <%= tenAnToan %>">
    <i class="fa-solid fa-circle-user"></i>
    <span class="ten">Xin chào, <%= tenAnToan %></span>
</a>
                            <a href="<%= ResolveUrl("~/DangNhap.aspx?dangxuat=1") %>"
                               class="logout-link"
                               title="Đăng xuất"
                               aria-label="Đăng xuất">
                                <i class="fa-solid fa-right-from-bracket"></i>
                            </a>
                        <% } else { %>
                            <a href="<%= ResolveUrl("~/DangNhap.aspx") %>"
                               class="login-link">
                                <i class="fa-solid fa-user"></i>
                                Đăng nhập
                            </a>
                            <span class="account-separator">/</span>
                            <a href="<%= ResolveUrl("~/DangKy.aspx") %>"
                               class="register-link">
                                <i class="fa-solid fa-user-plus"></i>
                                Đăng ký
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
        </header>

      
        <main>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        
    <footer class="footer">
    <div class="container footer-ba-cot">

       
        <div class="fc fc-trai">
            <h4>Thông tin liên hệ</h4>
            <p>Hotline tư vấn: 0901 234 567</p>
            <p>Địa chỉ: 123 Đường ABC, Bắc Ninh</p>
            <p>Email: hello@sweetcake.vn</p>
            <p>Giờ mở cửa: 8:00 – 21:00 mỗi ngày</p>
        </div>


<div class="fc fc-giua">
    <p class="footer-brand">
        <i class="fa-solid fa-cake-candles"></i> SweetCake
    </p>
    <p class="footer-khau-hieu">Ngọt ngào trong từng chiếc bánh.</p>

</div>
        
        <div class="fc fc-phai">
            <h4>Liên kết</h4>
            <div class="footer-mxh">
                <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook"></i></a>
                <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                <a href="#" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
            </div>
            <div class="footer-menu">
                <a href="<%= ResolveUrl("~/SanPham.aspx") %>">Sản phẩm</a>
                <a href="<%= ResolveUrl("~/TinTuc.aspx") %>">Tin tức</a>
                <a href="<%= ResolveUrl("~/TuVan.aspx") %>">Tư vấn</a>
            </div>
        </div>

    </div>
    <div class="footer-ban-quyen">© 2026 SweetCake. Bảo lưu mọi quyền.</div>
</footer>
    </form>

    
    <script src="<%= ResolveUrl("~/JS/Site.js") %>"></script>
</body>
</html>